APP_NAME=StudyCenterNias
APP_ENV=local
APP_KEY=base64:OUmK/VoQaLH231TZvX5GVQvmZj6o8YvaDLQYw6Fjbw8=
APP_DEBUG=true
APP_URL=http://localhost

# --- Database ---
# PENTING: DB_HOST pakai service name "mysql", bukan 127.0.0.1
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=study_center_nias
DB_USERNAME=scnias
DB_PASSWORD=scnias_secret_2024
DB_ROOT_PASSWORD=root_secret_change_me

# --- Redis ---
# PENTING: REDIS_HOST pakai service name "redis", bukan 127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Cache / Session / Queue ---
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=database

# --- External USB Mount Paths ---
# Pastikan direktori ini sudah ada dan permission sudah di-set sebelum `docker compose up`
# MySQL: sudo chown -R 999:999 /mnt/usb/study-center/mysql
# Logs:  sudo chown -R 33:33 /mnt/usb/study-center/logs   (UID 33 = www-data)
EXTERNAL_MYSQL_PATH=/mnt/usb/study-center/mysql
EXTERNAL_LOGS_PATH=/mnt/usb/study-center/logs

# --- Mail (opsional) ---
MAIL_MAILER=log
